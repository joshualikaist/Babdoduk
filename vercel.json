{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/data/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "https://www.babdodukms.com",
        "Link": "</LICENSE>; rel=\"license\""
      },
      "continue": true
    },
    {
      "src": "/LICENSE",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/(food\\.html|lab\\.html|lab-ggongbab\\.html|cardnews\\.html|my\\.html|data/cardnews/.+|calendar\\.ics|data/food-log\\.json)",
      "missing": [
        {
          "type": "host",
          "value": "babdoduk-lab.vercel.app"
        }
      ],
      "status": 404
    }
  ]
}
