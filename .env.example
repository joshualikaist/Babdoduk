# Copy to .env (gitignored). Never commit real values.

# Dooray (gov-dooray). Token goes only into the Authorization header.
DOORAY_API_TOKEN=
DOORAY_PROJECT_ID=4424523215847914253

# Supabase - the secret key is backend-only. Never expose to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy name, read only when SUPABASE_SECRET_KEY is empty.
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Responses API + Structured Outputs)
OPENAI_API_KEY=

GGONGBAB_AI_MODEL=gpt-5.6-luna
GGONGBAB_AI_FALLBACK_MODEL=gpt-5.6-terra

# Optional tuning
# GGONGBAB_AI_CONFIDENCE_THRESHOLD=0.75   # below this the fallback model is consulted
# GGONGBAB_PUBLISH_CONFIDENCE=0.7         # below this an event is not exported
# GGONGBAB_EXPIRED_GRACE_HOURS=3
# GGONGBAB_KAIST_PUBLIC_ENABLED=true
