    {
      "id": "web-exa-trend",
      "name": "Web search: trends (Exa)",
      "type": "web_search",
      "enabled": true,
      "trustTier": "C",
      "categories": [
        "trend"
      ],
      "lane": "trend",
      "discoveryMethod": "exa_mcp",
      "requireFood": true,
      "kind": "mixed",
      "queries": [
        "{year} {month}월 편의점 신상",
        "편의점 먹거리 유행",
        "요즘 음식 트렌드",
        "먹방 유행",
        "신메뉴 인기",
        "편의점 디저트 신상",
        "요즘 간편식",
        "대학생 먹거리 트렌드",
        "혼밥 트렌드",
        "한국 음식 트렌드"
      ],
      "objective": "Recent Korean news, reports or blog posts from the last month about foods, convenience-store products or menus that are newly released or popular now, especially for students and single-person households. Exclude shopping pages and plain recipes.",
      "note": "Tier per result host (discovery.hosts). Search is discovery only; a result needs retrieved text."
    },
    {
      "id": "web-exa-habit",
      "name": "Web search: eating habits (Exa)",
      "type": "web_search",
      "enabled": true,
      "trustTier": "C",
      "categories": [
        "habit"
      ],
      "lane": "habit",
      "discoveryMethod": "exa_mcp",
      "requireFood": true,
      "kind": "mixed",
      "queries": [
        "{year} 식습관 트렌드",
        "1인 가구 식생활",
        "대학생 식습관",
        "혼밥 식습관",
        "점심 도시락 트렌드",
        "저당 식품 트렌드",
        "웰니스 식사",
        "간편식 식습관",
        "식사 습관 한국",
        "건강한 식생활"
      ],
      "objective": "Korean news, surveys, consumer reports or research about how people eat: meal patterns, skipping meals, eating alone, single-person households, students, ready meals and lunch boxes, low-sugar and wellness eating. Prefer recent reporting and dated studies. Exclude recipes and shopping pages.",
      "note": "Habit needs a Tier A/B host, a date and behavior evidence; news <= 90 days, research <= 2 years."
    },
    {
      "id": "web-naver-trend",
      "name": "Naver Blog (site search)",
      "type": "web_search",
      "enabled": true,
      "trustTier": "C",
      "categories": [
        "trend"
      ],
      "lane": "trend",
      "discoveryMethod": "exa_mcp",
      "requireFood": true,
      "kind": "mixed",
      "queries": [
        "site:blog.naver.com {year} {month}월 편의점 신상 후기",
        "site:blog.naver.com 요즘 유행 디저트 후기",
        "site:blog.naver.com 편의점 신상 꿀조합",
        "site:blog.naver.com {month}월 신메뉴 후기"
      ],
      "objective": "Recent Naver blog posts where people try new foods, convenience-store products or popular menus. Exclude sponsored posts and shopping pages.",
      "note": "Tier C discovery: new products and what people are trying, never health or nutrition evidence. No Naver API or RSS search route exists; public site search only."
    },
