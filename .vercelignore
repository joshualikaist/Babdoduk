.local
.env
.vercel
__pycache__
.pytest_cache
# Magazine discovery research store: kept in git, never served by the site.
research
# Not site resources: code, tests, documentation, authored inputs, contracts and tool
# settings stay in git and are never deployed. The site is the pages, css/, js/, images/,
# data/ and manifest.json.
scripts
tests
docs
supabase
inputs
i18n
schemas
# Shared labels and page content: written into the pages by scripts/sync_site_chrome.py, never fetched.
data/content
shared
.claude
.cursor
.github
*.md
*.txt
# robots.txt is a site resource: the crawler rules and the rights notice (docs/PUBLIC_EXPOSURE.md).
!robots.txt
*.ini
.env.example
.gitattributes
.gitignore
