{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Proactive",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git worktree list:*)",
      "Bash(git stash list:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch origin --prune)",
      "Bash(python -m pytest:*)",
      "Bash(python scripts/validate_content.py)",
      "Bash(python scripts/check_site_ui.py)",
      "Bash(python scripts/check_site_ui.py --screenshots)",
      "Bash(python scripts/check_ggongbab_ui.py)",
      "Bash(python scripts/check_ggongbab_ui.py --preview)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -df:*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_guard.py\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/statusline.ps1')\""
  }
}
