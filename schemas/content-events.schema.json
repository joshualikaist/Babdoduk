{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/content-events.schema.json",
  "title": "News and events: data/content/events.json",
  "description": "Written by a person: only what the owner has actually announced. scripts/sync_site_chrome.py writes it into event.html (rows by start date, notices newest first). A detail value may carry <strong> and no other markup (validate_content.py); every other text is plain. docs/EVENT_DETAIL_FIELDS.md.",
  "type": "object",
  "required": ["schemaVersion", "notices", "activities"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title", "text"],
        "additionalProperties": false,
        "properties": {
          "date": {"$ref": "#/$defs/date"},
          "title": {"$ref": "#/$defs/pair"},
          "text": {"$ref": "#/$defs/pair"}
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "confirmation", "link", "title", "details"],
        "additionalProperties": false,
        "properties": {
          "start": {"$ref": "#/$defs/date"},
          "end": {"$ref": "#/$defs/date"},
          "confirmation": {
            "description": "What was announced or verified. A date passing never makes an activity held.",
            "enum": ["announced", "tentative", "held", "cancelled"]
          },
          "link": {
            "description": "The original post (https://), or a page of this site where people take part (name.html; it must exist).",
            "anyOf": [{"type": "string", "pattern": "^https://"}, {"type": "string", "pattern": "^[a-z0-9-]+[.]html$"}]
          },
          "title": {"$ref": "#/$defs/pair"},
          "place": {"$ref": "#/$defs/pair"},
          "pictures": {
            "description": "Up to two real pictures shown on the row (never a placeholder), with their credit in both languages.",
            "type": "object",
            "required": ["images", "credit"],
            "additionalProperties": false,
            "properties": {
              "images": {"type": "array", "minItems": 1, "maxItems": 2,
                         "items": {"type": "string", "pattern": "^images/[a-z0-9/_-]+[.](jpg|png|webp)$"}},
              "credit": {"$ref": "#/$defs/pair"}
            }
          },
          "details": {
            "description": "The fixed labelled rows (summary, duration, prizes, participation; at least the summary), or one note for an activity they do not fit.",
            "anyOf": [
              {
                "type": "object",
                "required": ["summary"],
                "additionalProperties": false,
                "properties": {
                  "summary": {"$ref": "#/$defs/pair"},
                  "duration": {"$ref": "#/$defs/pair"},
                  "prizes": {"$ref": "#/$defs/pair"},
                  "participation": {"$ref": "#/$defs/pair"}
                }
              },
              {
                "type": "object",
                "required": ["note"],
                "additionalProperties": false,
                "properties": {"note": {"$ref": "#/$defs/pair"}}
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "pair": {
      "type": "object",
      "required": ["ko", "en"],
      "additionalProperties": false,
      "properties": {
        "ko": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    }
  }
}
