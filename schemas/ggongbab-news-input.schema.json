{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/ggongbab-news-input.schema.json",
  "title": "Campus food news, public items: inputs/ggongbab/food-news.json",
  "description": "Written on the operator PC by `python scripts/export_food_news.py --review` from the private review file (.local/, never committed) and committed by a person. Public items only: the same item as data/ggongbab/news.json, with no review evidence.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "contentType", "noticeDate", "title", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^news-[a-f0-9]{32}$"},
        "contentType": {"const": "campus_food_news"},
        "noticeDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "summary": {"type": "string", "minLength": 1, "maxLength": 160},
        "location": {"type": "string", "minLength": 1, "maxLength": 160},
        "hasFreeOffer": {"type": "boolean"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "anyOf": [
              {"type": "object", "required": ["type", "name"], "additionalProperties": false,
               "properties": {"type": {"const": "portal"}, "name": {"const": "KAIST 포탈"}}},
              {"type": "object", "required": ["type", "name"], "additionalProperties": false,
               "properties": {"type": {"const": "kaist_public"}, "name": {"const": "KAIST 공지"}}}
            ]
          }
        }
      }
    }
  }
}
