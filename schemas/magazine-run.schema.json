{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/magazine-run.schema.json",
  "title": "One line of research/magazine/runs.jsonl",
  "description": "Appended by every magazine run (at most 400 lines kept), never deployed: when it ran, the queries it sent, its counts and the edition it built. An offline rebuild says mode \"offline\".",
  "type": "object",
  "required": ["runAt", "counts"],
  "additionalProperties": false,
  "properties": {
    "runAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "mode": {"const": "offline"},
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "query"],
        "additionalProperties": false,
        "properties": {"sourceId": {"type": "string"}, "query": {"type": "string"}}
      }
    },
    "counts": {"type": "object", "properties": {"fabricated": {"const": 0}}},
    "edition": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
