{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/campus-buildings.schema.json",
  "title": "Campus building table: data/campus/buildings.json",
  "description": "Generated by scripts/campus3d/buildings.py from OpenStreetMap (inputs/campus3d/campus.json) and inputs/campus3d/buildings-extra.json; read by the 3D campus map to put a pin on an event's building (docs/CAMPUS_MAP.md). Positions are meters east and north of the origin; top is the roof height in meters.",
  "type": "object",
  "required": ["schemaVersion", "attribution", "origin", "buildings", "unplaced"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "attribution": {"const": "Map data from OpenStreetMap (ODbL)"},
    "origin": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {"lat": {"type": "number", "minimum": 36.3, "maximum": 36.4},
                     "lon": {"type": "number", "minimum": 127.3, "maximum": 127.4}}
    },
    "buildings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placed"}},
    "unplaced": {"type": "array", "items": {"$ref": "#/$defs/unplaced"}}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[EWNS][0-9]{1,2}(-[0-9])?$"},
    "names": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 80}, "uniqueItems": true},
    "placed": {
      "type": "object",
      "required": ["code", "name", "nameEn", "aliases", "at", "top"],
      "additionalProperties": false,
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "nameEn": {"type": "string", "minLength": 1, "maxLength": 120},
        "aliases": {"$ref": "#/$defs/names"},
        "at": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -2000, "maximum": 2000}},
        "top": {"type": "number", "minimum": 2, "maximum": 120}
      }
    },
    "unplaced": {
      "type": "object",
      "required": ["code", "name", "nameEn", "aliases"],
      "additionalProperties": false,
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "nameEn": {"type": "string", "minLength": 1, "maxLength": 120},
        "aliases": {"$ref": "#/$defs/names"}
      }
    }
  }
}
