{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/food-log.schema.json",
  "title": "Food log, creator's own entries: data/food-log.json",
  "description": "Written by a person, read by food.html, which the site serves on babdoduk-lab only (vercel.json). Amounts are whole won; a day's total is the sum its items list, which validate_content.py checks.",
  "type": "object",
  "required": ["currency", "entries"],
  "additionalProperties": false,
  "properties": {
    "currency": {"const": "KRW"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "total", "items"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "total": {"type": "integer", "minimum": 0},
          "note": {"type": "string"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["meal", "label", "amount"],
              "additionalProperties": false,
              "properties": {
                "meal": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "amount": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
