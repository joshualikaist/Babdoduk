{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/content-history.schema.json",
  "title": "History timeline: data/content/history.json",
  "description": "Written by a person. scripts/sync_site_chrome.py writes it into history.html: milestones oldest first, each date shown as 2025.4.1 and Apr 1, 2025, then the roadmap.",
  "type": "object",
  "required": ["schemaVersion", "milestones", "roadmap"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "title", "text", "picture"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "title": {"$ref": "#/$defs/pair"},
          "text": {"$ref": "#/$defs/pair"},
          "picture": {
            "description": "A real image under images/ with its size, or a word set as a mark. Never a placeholder photo.",
            "anyOf": [
              {
                "type": "object",
                "required": ["image", "width", "height", "alt"],
                "additionalProperties": false,
                "properties": {
                  "image": {"type": "string", "pattern": "^images/[a-z0-9-]+\\.(png|jpg|jpeg|webp)$"},
                  "width": {"type": "integer", "minimum": 1},
                  "height": {"type": "integer", "minimum": 1},
                  "alt": {"$ref": "#/$defs/pair"}
                }
              },
              {
                "type": "object",
                "required": ["mark", "alt"],
                "additionalProperties": false,
                "properties": {
                  "mark": {"type": "string", "minLength": 1, "maxLength": 12},
                  "alt": {"$ref": "#/$defs/pair"}
                }
              }
            ]
          }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "required": ["title", "text"],
      "additionalProperties": false,
      "properties": {
        "title": {"$ref": "#/$defs/pair"},
        "text": {"$ref": "#/$defs/pair"}
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "required": ["ko", "en"],
      "additionalProperties": false,
      "properties": {
        "ko": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    }
  }
}
