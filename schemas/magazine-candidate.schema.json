{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/magazine-candidate.schema.json",
  "title": "One line of research/magazine/candidates.jsonl",
  "description": "The magazine's candidate store (scripts/discovery/store.py), written by the content bot and never deployed. A row is whole while it can still change a decision and compact afterwards (store.FINGERPRINT, or store.ANCHOR for a published story). The closed key set is the privacy contract: a field outside discovery.store.FIELDS (a cookie, a token, a session) fails.",
  "anyOf": [{"$ref": "#/$defs/whole"}, {"$ref": "#/$defs/compact"}],
  "$defs": {
    "id": {"type": "string", "pattern": "^c_[0-9a-f]{16}$"},
    "url": {"type": "string", "pattern": "^https?://[^\\s/]+"},
    "str": {"type": ["string", "null"]},
    "num": {"type": ["number", "null"]},
    "int": {"type": ["integer", "null"]},
    "bool": {"type": ["boolean", "null"]},
    "list": {"type": ["array", "null"]},
    "obj": {"type": ["object", "null"]},
    "whole": {
      "type": "object",
      "required": ["candidateId", "sourceUrl"],
      "additionalProperties": false,
      "properties": {
        "candidateId": {"$ref": "#/$defs/id"},
        "sourceUrl": {"$ref": "#/$defs/url"},
        "sourceId": {"$ref": "#/$defs/str"},
        "sourceName": {"$ref": "#/$defs/str"},
        "sourceType": {"$ref": "#/$defs/str"},
        "canonicalUrl": {"$ref": "#/$defs/str"},
        "title": {"$ref": "#/$defs/str"},
        "sourceExcerpt": {"$ref": "#/$defs/str"},
        "publishedAt": {"$ref": "#/$defs/str"},
        "discoveredAt": {"$ref": "#/$defs/str"},
        "lastSeenAt": {"$ref": "#/$defs/str"},
        "imageUrl": {"$ref": "#/$defs/str"},
        "imageSource": {"$ref": "#/$defs/str"},
        "imageValidated": {"$ref": "#/$defs/bool"},
        "categoryHints": {"$ref": "#/$defs/list"},
        "assignedCategory": {"$ref": "#/$defs/str"},
        "discoveryQuery": {"$ref": "#/$defs/str"},
        "discoveryMethod": {"$ref": "#/$defs/str"},
        "contentHash": {"$ref": "#/$defs/str"},
        "canonicalHash": {"$ref": "#/$defs/str"},
        "sourceItemId": {"$ref": "#/$defs/str"},
        "duplicateOf": {"$ref": "#/$defs/str"},
        "qualityScore": {"$ref": "#/$defs/num"},
        "freshnessScore": {"$ref": "#/$defs/num"},
        "sourceScore": {"$ref": "#/$defs/num"},
        "relevanceScore": {"$ref": "#/$defs/num"},
        "score": {"$ref": "#/$defs/num"},
        "selected": {"$ref": "#/$defs/bool"},
        "selectedAt": {"$ref": "#/$defs/str"},
        "rejectionReason": {"$ref": "#/$defs/str"},
        "medium": {"$ref": "#/$defs/str"},
        "trustTier": {"$ref": "#/$defs/str"},
        "seenVia": {"$ref": "#/$defs/list"},
        "textLength": {"$ref": "#/$defs/int"},
        "discoveredSeq": {"$ref": "#/$defs/int"},
        "selectedFor": {"$ref": "#/$defs/str"},
        "discoveryLane": {"$ref": "#/$defs/str"},
        "seenQueries": {"$ref": "#/$defs/list"},
        "searchRank": {"$ref": "#/$defs/int"},
        "sourceTrust": {"$ref": "#/$defs/str"},
        "contentKind": {"$ref": "#/$defs/str"},
        "publishedAtSource": {"$ref": "#/$defs/str"},
        "trendSignals": {"$ref": "#/$defs/obj"},
        "trendEvidence": {"$ref": "#/$defs/list"},
        "trendEvidenceDetail": {"$ref": "#/$defs/obj"},
        "corroboratedBy": {"$ref": "#/$defs/list"},
        "habitSignals": {"$ref": "#/$defs/obj"},
        "audienceRelevance": {"$ref": "#/$defs/obj"},
        "audienceScore": {"$ref": "#/$defs/num"},
        "laneDecisions": {"$ref": "#/$defs/obj"},
        "viewCount": {"$ref": "#/$defs/int"},
        "likeCount": {"$ref": "#/$defs/int"},
        "requireFood": {"$ref": "#/$defs/bool"},
        "commercePage": {"$ref": "#/$defs/bool"},
        "sponsored": {"$ref": "#/$defs/bool"},
        "howToMarkers": {"$ref": "#/$defs/int"},
        "trendEvidenceIndependent": {"$ref": "#/$defs/list"}
      }
    },
    "compact": {
      "type": "object",
      "required": ["candidateId", "sourceUrl", "compact"],
      "additionalProperties": false,
      "properties": {
        "compact": {"const": true},
        "candidateId": {"$ref": "#/$defs/id"},
        "sourceUrl": {"$ref": "#/$defs/url"},
        "sourceId": {"type": "string"},
        "title": {"type": "string"},
        "discoveryMethod": {"type": "string"},
        "discoveryQuery": {"type": "string"},
        "discoveryLane": {"type": "string"},
        "discoveredAt": {"type": "string"},
        "discoveredSeq": {"type": "integer"},
        "lastSeenAt": {"type": "string"},
        "rejectionReason": {"type": "string"},
        "duplicateOf": {"$ref": "#/$defs/id"},
        "canonicalUrl": {"type": "string"},
        "canonicalHash": {"type": "string"},
        "sourceItemId": {"type": "string"},
        "contentHash": {"type": "string"},
        "publishedAt": {"type": "string"},
        "assignedCategory": {"type": "string"},
        "selected": {"const": true},
        "selectedAt": {"type": "string"},
        "selectedFor": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}
