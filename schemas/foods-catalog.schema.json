{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshualikaist/Babdoduk/schemas/foods-catalog.schema.json",
  "title": "Food dictionary index: data/foods/catalog.json",
  "description": "The pack list and the picker's score weights, read by js/food-engine.js (the magazine's #what picker). Each pack lists its file and dish count; validate_content.py checks the counts against the packs.",
  "type": "object",
  "required": ["schemaVersion", "count", "packs", "scoreWeights"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "count": {"type": "integer", "minimum": 1},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "src", "count"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "src": {"type": "string", "pattern": "^data/foods/packs/[a-z0-9-]+\\.json$"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "scoreWeights": {
      "type": "object",
      "required": ["taste", "craving", "context", "satietyHealth", "budgetDining", "popularityNovelty"],
      "additionalProperties": false,
      "properties": {
        "taste": {"type": "integer", "minimum": 0},
        "craving": {"type": "integer", "minimum": 0},
        "context": {"type": "integer", "minimum": 0},
        "satietyHealth": {"type": "integer", "minimum": 0},
        "budgetDining": {"type": "integer", "minimum": 0},
        "popularityNovelty": {"type": "integer", "minimum": 0}
      }
    }
  }
}
